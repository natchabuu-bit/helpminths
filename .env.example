# Owner login name for host-authorized first setup; not a password.
# HELPMINTHS_OWNER_USERNAME="Super Admin"
# Set this private secret in Render Environment to create/recover the real owner.
# No default is provided. Minimum 4 characters; do not commit a real password.
# HELPMINTHS_SUPER_ADMIN_PASSWORD=
# Example only: .env files are NOT loaded automatically. Export variables in
# your shell or configure them in your hosting provider before starting the API.
# Docker/Render enables private temporary image storage automatically. Local files
# need a mounted durable volume; external accounts can use PostgreSQL below.
# Never store private files under public/ or dist/.
# Outside Docker, opt into auto storage only when /var/lib/helpminths is writable,
# or set an explicit writable private directory below. Auto storage is never durable.
# HELPMINTHS_AUTO_STORAGE=1
HELPMINTHS_DATA_DIR=
HELPMINTHS_STORAGE_DURABLE=0
HELPMINTHS_COOKIE_SECURE=1
HELPMINTHS_SESSION_HOURS=8
# Optional external account/document database for Render Free. Store the URL
# only in Render Environment; never use a VITE_ variable or commit a real URL.
# HELPMINTHS_DATABASE_BACKEND=postgres
# HELPMINTHS_DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@SESSION_POOLER:5432/postgres?sslmode=require
# Optional: put the raw database password here instead of encoding it in the URI.
# When set, this replaces any URI password. Keep it private; omit if unused.
# HELPMINTHS_DATABASE_PASSWORD=
# External PostgreSQL retains accounts/approvals/documents; images still require
# separate durable image storage. A connection failure never uses local SQLite.
# Optional host-owner secret for first-admin web setup: 32–256 random printable
# ASCII chars. Remove it after setup. Public registration always creates lab users.
HELPMINTHS_ADMIN_SETUP_TOKEN=
# Optional trusted helminth YOLO detection checkpoint for the running API.
# Docker downloads the owner's selected artifact from models/source.json at build time;
# see models/README.md for build arguments. The running API does not download weights.
# Blank: auto-detect models/parasite_yolo.pt when that exact file is present.
# A nonempty value overrides the automatic path; an invalid override never falls back.
HELPMINTHS_MODEL_PATH=
HELPMINTHS_TRAINING_DATASET_VERSION=
HELPMINTHS_VALIDATION_DATASET_VERSION=
HELPMINTHS_CONFIDENCE_THRESHOLD=0.15
HELPMINTHS_REVIEW_CONFIDENCE=0.5
HELPMINTHS_QUALITY_MIN_WIDTH=512
HELPMINTHS_QUALITY_MIN_HEIGHT=384
HELPMINTHS_QUALITY_MIN_FOCUS_VARIANCE=30
HELPMINTHS_QUALITY_MIN_BRIGHTNESS=35
HELPMINTHS_QUALITY_MAX_BRIGHTNESS=225
HELPMINTHS_QUALITY_MIN_CONTRAST=12
HELPMINTHS_QUALITY_MAX_CLIPPED_FRACTION=0.45
HELPMINTHS_QUALITY_THUMBNAIL_SIZE=512
HELPMINTHS_QUALITY_ALLOW_OVERRIDE=1

# Restore the original reviewed workbook and historical dashboard.
# The explicit restore flag overrides stale Google-source environment settings.
# Enable live mode only after verifying its actual source: restore=0, source=google_sheets.
HELPMINTHS_DASHBOARD_RESTORE_SNAPSHOT=1
HELPMINTHS_DASHBOARD_SOURCE=snapshot

# Public school statistics approved by the owner; never personal records or raw notes.
HELPMINTHS_SHEETS_ENABLED=1
HELPMINTHS_SHEETS_ID=1pvGSBJEykTf5NUEsd3SqVdOqpYbpibTj07p23yJ5o-8
# Empty gid selects the first tab; set a numeric gid or worksheet for another tab.
HELPMINTHS_SHEETS_GID=
HELPMINTHS_SHEETS_WORKSHEET=
# auto tries CSV first, then the same file as Excel if its format export fails.
HELPMINTHS_SHEETS_FORMAT=auto
HELPMINTHS_SHEETS_REFRESH_SECONDS=30
# This explicit 1 publishes the approved aggregate summary.
# Set 0 for authenticated-only access when choosing a different source.
HELPMINTHS_SHEETS_PUBLIC_AGGREGATES=1
# Explicit preset validates the confirmed three-row school report header.
HELPMINTHS_SHEETS_COLUMN_MAPPING={"preset":"health2-kpd-school-v1"}
# Optional private-sheet reader: install backend/requirements-sheets.txt.
# Configure the complete service-account JSON as a hosting secret; never commit it.
HELPMINTHS_GOOGLE_SERVICE_ACCOUNT_JSON=
