# Owner login name for host-authorized first setup; not a password.
# HELPMINTHS_OWNER_USERNAME="Super Admin"
# Set only as a private hosting secret; creates/recovers the owner on startup.
# No default password is provided. Do not commit a real value.
# HELPMINTHS_SUPER_ADMIN_PASSWORD=
# Optional. Point to your own trained YOLO detection weights; never commit weights.
# HELPMINTHS_MODEL_PATH=/workspace/models/helpminths/best.pt

# Optional private storage. Use a real mounted volume for hosted persistence.
# Docker already enables automatic temporary storage; use an explicit path for a volume.
# HELPMINTHS_AUTO_STORAGE=1
# HELPMINTHS_DATA_DIR=/var/data/helpminths
# HELPMINTHS_STORAGE_DURABLE=1
# Free external account database (e.g. Supabase Session pooler); backend only.
# HELPMINTHS_DATABASE_BACKEND=postgres
# HELPMINTHS_DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@SESSION_POOLER:5432/postgres?sslmode=require
# Keep real credentials in host secrets. Local image files remain temporary.
# Optional host-owner secret for first-admin web setup, 32–256 random ASCII chars.
# Set through hosting secrets and remove after setup; never commit a real value.
# HELPMINTHS_ADMIN_SETUP_TOKEN=

# Original dashboard restored; live settings below are inactive while restore=1.
HELPMINTHS_DASHBOARD_RESTORE_SNAPSHOT=1
HELPMINTHS_DASHBOARD_SOURCE=snapshot
HELPMINTHS_SHEETS_ID=1pvGSBJEykTf5NUEsd3SqVdOqpYbpibTj07p23yJ5o-8
HELPMINTHS_SHEETS_GID=
HELPMINTHS_SHEETS_COLUMN_MAPPING={"preset":"health2-kpd-school-v1"}
HELPMINTHS_SHEETS_PUBLIC_AGGREGATES=1
HELPMINTHS_SHEETS_REFRESH_SECONDS=30
